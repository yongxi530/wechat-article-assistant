# WeChat Article Assistant Environment Variables

# WeChat Configuration
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here
WECHAT_TOKEN=your_wechat_token_here

# Database Configuration
DATABASE_URL=sqlite:///./database.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/wechat_assistant
# For MySQL: DATABASE_URL=mysql+pymysql://user:password@localhost:3306/wechat_assistant

# API Configuration
API_HOST=localhost
API_PORT=8000
API_DEBUG=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Article Processing
ARTICLE_MAX_LENGTH=5000
ARTICLE_TIMEOUT=30

# OpenAI Configuration (if using AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# JWT Configuration (if using authentication)
JWT_SECRET=your_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Environment
ENVIRONMENT=development
