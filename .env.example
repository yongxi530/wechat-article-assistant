# Environment Variables Template
# Copy this file to .env and fill in your actual values

# WeChat Configuration
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=

# Database Configuration
DATABASE_URL=
DATABASE_NAME=

# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys
API_KEY=
SECRET_KEY=

# Logging
LOG_LEVEL=info
